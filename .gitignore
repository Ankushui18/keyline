# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test and audit artefacts (generated by scripts/)
audit/
coverage/
playwright-report/
test-results/

# TypeScript incremental build caches
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Wasm build output (solver/pkg is committed on purpose: it lets the app
# run without a Rust toolchain. Rebuild it with `npm run build:solver`.)
solver/target/

# Editor and OS files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local environment overrides
.env
.env.local
.env.*.local
