# Normalise text files so a clone on Windows and CI on Linux agree.
* text=auto eol=lf

# Windows-only scripts would need CRLF, but this repo has none.

# Binary assets must never be line-ending converted.
*.wasm binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Keep generated lockfiles out of diffs in review unless dependencies change.
package-lock.json linguist-generated=true
solver/Cargo.lock linguist-generated=true
solver/pkg/** linguist-generated=true
