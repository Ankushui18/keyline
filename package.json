{
  "name": "vector-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-collaboration.mjs",
    "build": "tsc -b && vite build",
    "preview": "node scripts/run-with-collaboration.mjs preview",
    "collab": "node server/collaboration-server.mjs",
    "test": "vitest run",
    "build:solver": "wasm-pack build solver --target web --release --out-dir pkg",
    "test:solver": "node scripts/test-solver.mjs",
    "test:collaboration": "node scripts/test-collaboration.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run build && npm test && npm run test:solver && npm run test:collaboration",
    "test:browser": "node scripts/test-browser.mjs",
    "test:design": "node scripts/test-browser.mjs design",
    "test:review": "node scripts/test-browser.mjs review"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.40.0",
    "dexie": "^4.0.11",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^2.3.0",
    "ws": "^8.22.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
